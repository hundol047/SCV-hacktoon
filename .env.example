# Server-only. Supply real values through deployment/environment secret settings.
BOPok_APP_URL=
BOPok_SUPABASE_URL=
BOPok_SUPABASE_KEY=
# Random secret, at least 32 characters. Never NEXT_PUBLIC.
BOPok_SESSION_SECRET=
# Optional OpenAI Responses API configuration; consent and budgets are required.
BOPok_AI_KEY=
BOPok_AI_MODEL=
BOPok_AI_INPUT_USD_PER_MILLION=
BOPok_AI_OUTPUT_USD_PER_MILLION=
BOPok_AI_DAILY_USD_LIMIT=1
BOPok_AI_DAILY_TOKEN_LIMIT=200000
BOPok_AI_DAILY_REQUEST_LIMIT=30
# Optional openrouteservice server key for actual road routing.
BOPok_ROUTE_KEY=
