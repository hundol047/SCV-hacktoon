# Server-only. Supply real values through deployment/environment secret settings.
BOPok_APP_URL=
BOPok_SUPABASE_URL=
BOPok_SUPABASE_KEY=
# Random secret, at least 32 characters. Never NEXT_PUBLIC.
BOPok_SESSION_SECRET=
# Optional OpenAI Responses API configuration; consent and budgets are required.
BOPok_AI_KEY=
BOPok_AI_MODEL=
BOPok_AI_INPUT_USD_PER_MILLION=
BOPok_AI_OUTPUT_USD_PER_MILLION=
BOPok_AI_DAILY_USD_LIMIT=1
BOPok_AI_DAILY_TOKEN_LIMIT=200000
BOPok_AI_DAILY_REQUEST_LIMIT=30
# Optional openrouteservice server key for actual road routing.
BOPok_ROUTE_KEY=

# Email OTP: public anon key; set the Supabase email template to {{ .Token }}.
BOPok_SUPABASE_ANON_KEY=
# Public server writes default to requiring an account; false is for isolated/demo environments.
BOPok_REQUIRE_AUTH=true
BOPok_REQUIRE_BOT=true
BOPok_TURNSTILE_SITE_KEY=
# Siteverify sends this in its POST body; provide an actual private process value.
BOPok_TURNSTILE_SECRET=
BOPok_REVIEWER_IDS=
BOPok_OPERATOR_IDS=
BOPok_GOOGLE_MAPS_KEY=
BOPok_REQUIRED_FEATURES=storage,auth,routing,transit,ai,bot,catalog,fx,maintenance,reviews,alerts,backup
BOPok_ALERTS_ENABLED=false
BOPok_ALERT_WEBHOOK_URL=
BOPok_OPS_SECRET=
# Dedicated PostgreSQL database URL and 64 hex character AES backup key, private process values.
BOPok_DATABASE_URL=
BOPok_RESTORE_DATABASE_URL=
BOPok_BACKUP_KEY=
BOPok_AUTH_MINUTE_LIMIT=60
BOPok_AUTH_DAILY_LIMIT=500
BOPok_STORAGE_DAILY_LIMIT=1000
BOPok_SESSION_DAILY_LIMIT=1000
BOPok_REVIEW_DAILY_LIMIT=1000
BOPok_ROUTE_DAILY_LIMIT=1000
BOPok_REFRESH_DAILY_LIMIT=100
# CI deployment and real physical-device checks; never commit actual values.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
BOPok_DEPLOY_URL=
BOPok_RELEASE_ID=
# CI opt-in variables; daily paid provider probes incur configured service charges.
BOPok_OPERATIONS_ENABLED=false
BOPok_PROVIDER_PAID_PROBES=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# Dedicated isolated app for status/rules load checks, not the public service.
BOPok_LOAD_URL=
BOPok_LOAD_CONCURRENCY=10
BOPok_LOAD_REQUESTS=100
# Storage/share load creates and deletes only its own synthetic trips on a dedicated test app.
BOPok_LOAD_ALLOW_WRITES=false
