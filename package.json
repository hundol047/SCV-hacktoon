{
  "name": "bopok",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:mobile": "node scripts/build-mobile.mjs",
    "build:android": "node scripts/build-android.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:postgres": "node scripts/test-postgres-backup.mjs",
    "test:load": "node scripts/load-check.mjs",
    "test:devices": "node scripts/test-physical-devices.mjs",
    "probe:deployment": "node scripts/probe-deployment.mjs",
    "probe:providers": "node scripts/probe-providers.mjs",
    "test:storage-load": "node scripts/storage-load.mjs",
    "data:korea": "node scripts/collect-korea-tourism.mjs",
    "data:korea:official": "node scripts/collect-tourapi.mjs",
    "probe:public-travel": "node scripts/probe-public-travel.mjs",
    "photos:collect": "node scripts/collect-korea-photos.mjs",
    "photos:verify": "node scripts/verify-photos.mjs",
    "prebuild": "node scripts/prepare-map-worker.mjs",
    "predev": "node scripts/prepare-map-worker.mjs",
    "test:lab": "npm --prefix vendor/my-ai-lab test",
    "test:lab:browser": "playwright test --config playwright.active-lab.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@smithy/credential-provider-imds": "^4.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "1.52.0",
    "maplibre-gl": "^6.17.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tz-lookup": "6.1.25",
    "world-countries": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.64.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "undici": "^8.12.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
